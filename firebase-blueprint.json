{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Footwear item in Mochi Steps store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "category", "price", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order in Mochi Steps store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentProofUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["totalAmount", "status", "paymentMethod"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer profile and contact in Mochi Steps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "totalOrders": { "type": "number" },
        "totalSpent": { "type": "number" },
        "lastOrderDate": { "type": "string" }
      },
      "required": ["name", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of products in Mochi Steps webstore"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of orders placed by customers"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Collection of customer records"
    }
  }
}
